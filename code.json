import numpy as np
row = int(input("Enter the number of rows:"))
col = int(input("Enter the number of columns:"))
# an empty matrix
mat1 = []
print("Enter the entries rowwise:")
# For getting elements from user
for i in range(row):      # for row entries
    a =[]
    for j in range(col):  # for column entries
        a.append(int(input()))
    mat1.append(a)
# an empty matrix
mat2 = []
print("Enter the entries rowwise:")
# For getting elements from user
for i in range(row):      # for row entries
    a =[]
    for j in range(col):  # for column entries
        a.append(int(input()))
    mat2.append(a)
# This will return dot product
res = np.dot(mat1,mat2)
# print resulted matrix
print(res)
